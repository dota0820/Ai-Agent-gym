# Pick ONE of the two AI providers.

# Option A — OpenRouter (https://openrouter.ai/keys). Used whenever this key is set.
OPENROUTER_API_KEY=
# Optional: which model the coach uses on OpenRouter. Needs tool calling + image input.
#   google/gemini-2.5-flash     (default, fast, cheap, best all-rounder for vision + food + links)
#   anthropic/claude-sonnet-5.5 (best Chinese coaching tone)
#   openai/gpt-4o               (strong ChatGPT alternative)
OPENROUTER_MODEL=
# Optional: separate model for vision/parsing endpoints (/api/food, /api/watch, /api/equipment, /api/exercise-import).
# Defaults to OPENROUTER_MODEL if left empty.
OPENROUTER_VISION_MODEL=

# Option B — Anthropic directly (https://console.anthropic.com). Uses Claude Opus 5.5.
ANTHROPIC_API_KEY=

# Optional: a passcode users must enter in 「我的」 before the AI coach works,
# so strangers who find the URL can't spend your API credits.
APP_PASSCODE=
