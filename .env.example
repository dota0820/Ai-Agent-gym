# Pick ONE of the two AI providers.

# Option A — OpenRouter (https://openrouter.ai/keys). Used whenever this key is set.
OPENROUTER_API_KEY=
# Optional: which model the coach uses on OpenRouter. Needs tool calling + image input.
#   anthropic/claude-sonnet-5.5  (default, recommended)
#   anthropic/claude-haiku-5.5   (cheapest)
#   anthropic/claude-opus-5.5    (most capable)
OPENROUTER_MODEL=

# Option B — Anthropic directly (https://console.anthropic.com). Uses Claude Opus 5.5.
ANTHROPIC_API_KEY=

# Optional: a passcode users must enter in 「我的」 before the AI coach works,
# so strangers who find the URL can't spend your API credits.
APP_PASSCODE=
